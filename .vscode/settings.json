{
    // --- Python Settings ---
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "${workspaceFolder}/install/setup.bash"
    ],
    "python.terminal.activateEnvInSelectedTerminal": true,
    // --- C++ Settings (IntelliSense) ---
    "C_Cpp.default.includePath": [
        "/opt/ros/humble/include/**",
        "${workspaceFolder}/install/**/include/**",
        "${workspaceFolder}/src/**"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    // --- ROS 2 Specific ---
    "ros.distro": "humble",
    // --- File Exclusions (Για να είναι καθαρός ο explorer) ---
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/build": false, // Το αφήνουμε false για να βλέπουμε αν χτίζεται κάτι
        "**/install": false,
        "**/log": true
    },
    // --- Editor Comfort ---
    "editor.formatOnSave": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    // Συμβατότητα με το ruff (αν το χρησιμοποιείς μέσω uv)
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    }
}