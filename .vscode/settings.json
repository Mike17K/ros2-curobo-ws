{
    // --- C++ Settings ---
    "C_Cpp.default.includePath": [
        "/opt/ros/humble/include/**",
        "${workspaceFolder}/install/**/include/**",
        "${workspaceFolder}/src/**"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.intelliSenseEngine": "default",
    // Αυτό είναι πολύ σωστό, αρκεί να έχεις τρέξει το make build μια φορά
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    // --- ROS 2 Specific ---
    "ros.distro": "humble",
    // --- Editor Comfort ---
    "editor.formatOnSave": true,
    // --- Python Settings ---
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "/opt/ros/humble/local/lib/python3.10/dist-packages",
        "${workspaceFolder}/install/local/lib/python3.10/dist-packages" // ΠΡΟΣΘΗΚΗ ΑΥΤΟΥ
    ],
    "python.analysis.typeCheckingMode": "basic", // ΕΝΕΡΓΟΠΟΙΗΣΗ ΓΙΑ SYNTAX ERRORS
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    // Προσθήκη για να βλέπεις τα λάθη σε πραγματικό χρόνο
    "python.analysis.diagnosticMode": "workspace",
    "python.autoComplete.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "/opt/ros/humble/local/lib/python3.10/dist-packages"
    ],
    "cmake.sourceDirectory": "/workspace",
    "ROS2.distro": "humble"
}