<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">
    <xacro:include filename="inertial.xacro" />

    <xacro:macro name="rotor" params="suffix x y">
        <joint name="rotor_${suffix}_joint" type="continuous">
            <parent link="base_link" />
            <child link="rotor_${suffix}" />
            <origin xyz="${x} ${y} 0.03" rpy="0 0 0" />
            <axis xyz="0 0 1" />
        </joint>
        <link name="rotor_${suffix}">
            <visual>
                <geometry>
                    <cylinder radius="0.1" length="0.01" />
                </geometry>
            </visual>
            <xacro:inertial_cylinder mass="0.02" length="0.01" radius="0.1">
                <origin xyz="0 0 0" rpy="0 0 0" />
            </xacro:inertial_cylinder>
        </link>
    </xacro:macro>

</robot>