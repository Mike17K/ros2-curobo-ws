<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">
    <xacro:include filename="inertial.xacro" />

    <link name="world"></link>

    <joint name="world_joint" type="fixed">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 0.1" rpy="0 0 0" />
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.3 0.3 0.05" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="0.3 0.3 0.05" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="1.0" x="0.3" y="0.3" z="0.05">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <!-- Macro για έλικες (0-3) -->
    <xacro:macro name="rotor" params="suffix x y">
        <joint name="rotor_${suffix}_joint" type="continuous">
            <parent link="base_link" />
            <child link="rotor_${suffix}" />
            <origin xyz="${x} ${y} 0.03" rpy="0 0 0" />
            <axis xyz="0 0 1" />
        </joint>
        <link name="rotor_${suffix}">
            <visual>
                <geometry>
                    <cylinder radius="0.1" length="0.01" />
                </geometry>
            </visual>
            <xacro:inertial_cylinder mass="0.02" length="0.01" radius="0.1">
                <origin xyz="0 0 0" rpy="0 0 0" />
            </xacro:inertial_cylinder>
        </link>
    </xacro:macro>

    <xacro:rotor suffix="0" x="0.15" y="0.15" />
    <xacro:rotor suffix="1" x="-0.15" y="-0.15" />
    <xacro:rotor suffix="2" x="0.15" y="-0.15" />
    <xacro:rotor suffix="3" x="-0.15" y="0.15" />
</robot>