{
    "name": "curobo-ros2-dev",
    // 1. Σύνδεση με το docker-compose
    "dockerComposeFile": "../../../docker-compose.yaml", 
    "service": "depth_anything_ros2_dev",
    "workspaceFolder": "/workspace",

    // 2. Οι ρυθμίσεις environment και volumes τραβιούνται αυτόματα από το compose.
    // Αν θέλεις να σιγουρέψεις ότι το VS Code "βλέπει" το display:
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },

    "postCreateCommand": "bash /workspace/scripts/setup_workspace.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros",
                "charliermarsh.ruff",
                "nvidia.nsight-vscode-edition"
            ],
            "settings": {
                // Χρήση του venv που είδαμε πριν
                "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
                "python.terminal.activateEnvInSelectedTerminal": true,
                "ros.distro": "humble"
            }
        }
    },
    "remoteUser": "root"
}
