{
    "name": "curobo-ros2-dev",
    // 1. Σύνδεση με το docker-compose
    "dockerComposeFile": "../../../docker-compose.yaml", 
    "service": "depth_anything_ros2_dev",
    "workspaceFolder": "/workspace",

    "postCreateCommand": "bash /workspace/scripts/setup_workspace.sh",
    "runArgs": [
        "--privileged",
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros",
                "charliermarsh.ruff",
                "nvidia.nsight-vscode-edition"
            ],
            "settings": {
                // Χρήση του venv που είδαμε πριν
                "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
                "python.terminal.activateEnvInSelectedTerminal": true,
                "ros.distro": "humble"
            }
        }
    },
    "remoteUser": "root"
}
