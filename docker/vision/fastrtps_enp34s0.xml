<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://eprosima.com">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>192.168.1.140</address>
            </interfaceWhiteList>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="whitelist_profile" is_default_profile="true">
